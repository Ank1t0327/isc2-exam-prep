var PRACTICE_TEST_SIZE = 100;
var PRACTICE_TESTS = 4;
var PRACTICE_TEST_DOMAIN_COUNTS = {
  1: 26,
  2: 10,
  3: 22,
  4: 24,
  5: 18
};

var state = {
  screen: 'home',
  queue: [],
  idx: 0,
  selected: null,
  answered: false,
  sessionLog: [],
  progress: {}
};

function domainOf(id){
  for (var i=0;i<DOMAINS.length;i++){ if (DOMAINS[i].id===id) return DOMAINS[i]; }
  return null;
}

function domainStats(domainId){
  var seen=0, correct=0;
  for (var i=0;i<QUESTIONS.length;i++){
    var q = QUESTIONS[i];
    if (q.domain!==domainId) continue;
    var p = state.progress[q.id];
    if (p){ seen+=p.seen; correct+=p.correct; }
  }
  return { seen: seen, correct: correct, pct: seen ? Math.round(100*correct/seen) : 0 };
}

function overallStats(){
  var seen=0, correct=0;
  for (var key in state.progress){
    var p = state.progress[key];
    seen+=p.seen; correct+=p.correct;
  }
  return { seen: seen, correct: correct, pct: seen ? Math.round(100*correct/seen) : 0 };
}

function missedPool(){
  return QUESTIONS.filter(function(q){
    var p = state.progress[q.id];
    return p && p.lastWrong;
  });
}

function shuffle(arr){
  var a = arr.slice();
  for (var i=a.length-1;i>0;i--){
    var j = Math.floor(Math.random()*(i+1));
    var tmp=a[i]; a[i]=a[j]; a[j]=tmp;
  }
  return a;
}

function prep(q){
  var options = q.opts.map(function(text, index){
    return {text:text, index:index};
  });

  var shuffled = shuffle(options);
  var correctOption = shuffled.find(function(item){
    return item.index === q.correct;
  });

  if (correctOption){
    var longestIndex = -1;
    var longestLength = -1;
    shuffled.forEach(function(item, index){
      if (item.text.length > longestLength){
        longestLength = item.text.length;
        longestIndex = index;
      }
    });

    if (shuffled[longestIndex] && shuffled[longestIndex].index === q.correct){
      var swapTarget = -1;
      for (var i=0;i<shuffled.length;i++){
        if (shuffled[i].index !== q.correct && shuffled[i].text.length < longestLength){
          swapTarget = i;
          break;
        }
      }
      if (swapTarget !== -1){
        var tmp = shuffled[longestIndex];
        shuffled[longestIndex] = shuffled[swapTarget];
        shuffled[swapTarget] = tmp;
      }
    }
  }

  var opts = shuffled.map(function(item){ return item.text; });
  var correct = shuffled.findIndex(function(item){ return item.index === q.correct; });
  var copy = {};
  for (var key in q) copy[key]=q[key];
  copy.opts = opts;
  copy.correct = correct;
  return copy;
}

function buildPracticeTest(testVariant){
  var byDomain = {};
  for (var domainId in PRACTICE_TEST_DOMAIN_COUNTS){
    byDomain[domainId] = QUESTIONS.filter(function(q){ return q.domain===Number(domainId); });
  }

  var selected = [];
  Object.keys(PRACTICE_TEST_DOMAIN_COUNTS).forEach(function(domainId){
    var domainQuestions = shuffle(byDomain[domainId]);
    var count = PRACTICE_TEST_DOMAIN_COUNTS[domainId];
    selected = selected.concat(domainQuestions.slice(0, count));
  });

  var shuffled = shuffle(selected);
  if (testVariant > 1){
    for (var i=0;i<testVariant;i++){
      shuffled = shuffle(shuffled);
    }
  }

  return shuffled.slice(0, PRACTICE_TEST_SIZE).map(prep);
}

function startSet(mode, domainId, testVariant){
  var pool;
  if (mode==='mock') pool = QUESTIONS;
  else if (mode==='domain') pool = QUESTIONS.filter(function(q){ return q.domain===domainId; });
  else pool = missedPool();
  if (!pool.length) return;

  var testPool = pool;
  if (mode==='mock'){
    testPool = buildPracticeTest(testVariant || 1);
  }

  state.queue = testPool.map(prep);
  state.idx = 0;
  state.selected = null;
  state.answered = false;
  state.sessionLog = [];
  state.screen = 'quiz';
  render();
}

function selectOption(i){
  if (state.answered) return;
  var q = state.queue[state.idx];
  state.selected = i;
  state.answered = true;
  var isCorrect = (i===q.correct);
  var p = state.progress[q.id] || {seen:0, correct:0, lastWrong:false};
  p.seen++;
  if (isCorrect){ p.correct++; p.lastWrong=false; } else { p.lastWrong=true; }
  state.progress[q.id] = p;
  state.sessionLog.push({id:q.id, domain:q.domain, correct:isCorrect});
  saveProgress();
  render();
}

function nextQuestion(){
  if (state.idx+1 >= state.queue.length){
    state.screen = 'results';
  } else {
    state.idx++;
    state.selected = null;
    state.answered = false;
  }
  render();
}

function goHome(){
  state.screen='home';
  render();
}

async function loadProgress(){
  try {
    var res = await window.storage.get('cc-progress', false);
    if (res && res.value) state.progress = JSON.parse(res.value);
  } catch (e) {
    state.progress = {};
  }
}

async function saveProgress(){
  try {
    await window.storage.set('cc-progress', JSON.stringify(state.progress), false);
  } catch (e) {
    console.error('progress save failed', e);
  }
}

function setPath(p){
  var el = document.getElementById('termPath');
  if (el) el.textContent = 'patch@cc-exam:~$ ' + p;
}

function renderHome(){
  setPath('./start_prep.sh');
  var missed = missedPool();
  var overall = overallStats();
  var rows = DOMAINS.map(function(d){
    var st = domainStats(d.id);
    var acc = st.seen ? (st.pct + '%') : '';
    return '<button class="domain-row" data-action="start-domain" data-domain="'+d.id+'">' +
      '<span class="d-idx">0'+d.id+'</span>' +
      '<span class="d-name">'+d.name+'</span>' +
      '<span class="d-bar-track"><span class="d-bar-fill" data-fill="'+d.weight+'"></span></span>' +
      '<span class="d-weight">'+d.weight+'%</span>' +
      '<span class="d-acc">'+acc+'</span>' +
    '</button>';
  }).join('');

  var lifetime = overall.seen ? ('<div class="stat-line">lifetime: '+overall.correct+'/'+overall.seen+' correct ('+overall.pct+'%) &middot; percentages on the right show your accuracy per domain</div>') : '';

  return '' +
    '<div class="eyebrow">isc2 &middot; certified in cybersecurity</div>' +
    '<h1 class="title">exam_outline.conf<span class="cursor"></span></h1>' +
    '<p class="subtitle">Four 100-question practice tests, structured to mirror the ISC2 CC exam format and domain weighting.</p>' +
    rows +
    '<div class="hint">click a domain to drill it individually, or launch one of the four full-length practice tests below</div>' +
    '<div class="btn-row">' +
      '<button class="btn primary" data-action="start-mock" data-test-id="1">practice test 1 &mdash; 100q</button>' +
      '<button class="btn primary" data-action="start-mock" data-test-id="2">practice test 2 &mdash; 100q</button>' +
      '<button class="btn primary" data-action="start-mock" data-test-id="3">practice test 3 &mdash; 100q</button>' +
      '<button class="btn primary" data-action="start-mock" data-test-id="4">practice test 4 &mdash; 100q</button>' +
      '<button class="btn" data-action="start-missed" '+(missed.length? '':'disabled')+'>review missed ('+missed.length+')</button>' +
    '</div>' +
    lifetime;
}

function renderQuiz(){
  var q = state.queue[state.idx];
  var d = domainOf(q.domain);
  setPath('./quiz --domain='+d.slug);
  var total = state.queue.length;
  var letters = ['A','B','C','D'];

  var optsHtml = q.opts.map(function(opt,i){
    var cls = 'opt';
    var tag = '';
    if (state.answered){
      if (i===q.correct){ cls+=' correct'; tag='<span class="tag">[ OK ]</span>'; }
      else if (i===state.selected){ cls+=' wrong'; tag='<span class="tag">[FAIL]</span>'; }
    }
    return '<button class="'+cls+'" data-action="select-option" data-index="'+i+'" '+(state.answered?'disabled':'')+'>' +
      '<span class="k">'+letters[i]+'</span><span class="opt-text">'+opt+'</span>'+tag+
    '</button>';
  }).join('');

  var explain = '';
  if (state.answered){
    var verdict = (state.selected===q.correct) ? 'correct.' : 'not quite.';
    explain = '<div class="explain"><b>'+verdict+'</b> '+q.exp+'</div>';
  }

  var isLast = (state.idx+1 >= total);
  var footer = '<div class="footer-row"><button class="link-btn" data-action="home">quit to menu</button>';
  if (state.answered){
    footer += '<button class="btn primary" data-action="next">'+(isLast?'see results &rarr;':'next question &rarr;')+'</button>';
  }
  footer += '</div>';

  return '' +
    '<div class="qmeta"><span>q '+(state.idx+1)+'/'+total+'</span><span>0'+d.id+' '+d.slug+'</span></div>' +
    '<div class="qprogress-track"><div class="qprogress-fill" style="width:'+Math.round(100*state.idx/total)+'%"></div></div>' +
    '<div class="qtext">'+q.text+'</div>' +
    optsHtml +
    explain +
    footer;
}

function renderResults(){
  setPath('./quiz --report');
  var total = state.sessionLog.length;
  var correctCount = state.sessionLog.filter(function(r){ return r.correct; }).length;
  var pct = total ? Math.round(100*correctCount/total) : 0;

  var byDomain = {};
  state.sessionLog.forEach(function(r){
    if (!byDomain[r.domain]) byDomain[r.domain] = {seen:0, correct:0};
    byDomain[r.domain].seen++;
    if (r.correct) byDomain[r.domain].correct++;
  });
  var rows = Object.keys(byDomain).map(function(dId){
    var d = domainOf(Number(dId));
    var s = byDomain[dId];
    var p = Math.round(100*s.correct/s.seen);
    return '<div class="domain-stat-row">' +
      '<span class="d-idx">0'+d.id+'</span>' +
      '<span class="d-name">'+d.name+'</span>' +
      '<span class="d-bar-track"><span class="d-bar-fill" style="width:'+p+'%"></span></span>' +
      '<span class="d-weight">'+p+'%</span>' +
    '</div>';
  }).join('');

  var missedThisSession = total - correctCount;

  return '' +
    '<div class="eyebrow">session complete</div>' +
    '<div class="score-big">'+correctCount+'/'+total+'</div>' +
    '<div class="score-sub">'+pct+'% correct this session</div>' +
    rows +
    '<div class="btn-row">' +
      (missedThisSession ? '<button class="btn" data-action="start-missed">review missed ('+missedPool().length+')</button>' : '') +
      '<button class="btn primary" data-action="home">back to menu</button>' +
    '</div>';
}

function render(){
  var app = document.getElementById('app');
  if (state.screen==='home'){
    app.innerHTML = renderHome();
    requestAnimationFrame(function(){
      document.querySelectorAll('.d-bar-fill[data-fill]').forEach(function(el){
        el.style.width = el.getAttribute('data-fill') + '%';
      });
    });
  } else if (state.screen==='quiz'){
    app.innerHTML = renderQuiz();
  } else {
    app.innerHTML = renderResults();
  }
}

document.getElementById('app').addEventListener('click', function(e){
  var btn = e.target.closest('[data-action]');
  if (!btn || btn.disabled) return;
  var action = btn.getAttribute('data-action');
  if (action==='start-mock') startSet('mock', null, Number(btn.getAttribute('data-test-id')) || 1);
  else if (action==='start-domain') startSet('domain', Number(btn.getAttribute('data-domain')));
  else if (action==='start-missed') startSet('missed');
  else if (action==='select-option') selectOption(Number(btn.getAttribute('data-index')));
  else if (action==='next') nextQuestion();
  else if (action==='home') goHome();
});

loadProgress().then(render);
</script>
</body>
</html>
