<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ISC2 CC Exam Prep — PatchSec</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #0a0e12;
  --panel: #10151b;
  --panel-2: #161d26;
  --border: #232c37;
  --border-soft: #1a222b;
  --text: #dbe2e9;
  --text-dim: #7c8794;
  --text-faint: #4a5460;
  --blue: #4f9eff;
  --blue-soft: #1a324f;
  --green: #3ecf8e;
  --green-soft: #123227;
  --red: #f0555a;
  --red-soft: #3a1c1f;
  --mono: 'JetBrains Mono', ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace;
  --radius: 4px;
}
* { box-sizing: border-box; }
html, body { margin:0; padding:0; }
body {
  font-family: var(--mono);
  background: radial-gradient(ellipse at top, #0d1219 0%, #05070a 100%);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  padding: 28px 14px;
}
.cc-app {
  width: 100%;
  max-width: 720px;
  background: var(--bg);
  border-radius: 10px;
  border: 1px solid var(--border);
  overflow: hidden;
  box-shadow: 0 24px 70px -24px rgba(0,0,0,0.7);
  height: fit-content;
}
.term-bar {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 11px 14px;
  background: var(--panel-2);
  border-bottom: 1px solid var(--border);
}
.dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink:0; }
.dot.r { background: #ff5f57; }
.dot.y { background: #febc2e; }
.dot.g { background: #28c840; }
.term-path {
  margin-left: 8px;
  font-size: 12px;
  color: var(--text-dim);
  letter-spacing: 0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cursor {
  display: inline-block;
  width: 7px;
  height: 15px;
  background: var(--blue);
  margin-left: 5px;
  vertical-align: -3px;
  animation: blink 1s steps(1) infinite;
}
@keyframes blink { 50% { opacity: 0; } }
.term-body { padding: 26px 24px; }

.eyebrow {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--text-faint);
  margin-bottom: 8px;
}
.title {
  font-size: 21px;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 6px;
  letter-spacing: -0.01em;
}
.subtitle {
  font-size: 13px;
  color: var(--text-dim);
  line-height: 1.5;
  margin: 0 0 22px;
  max-width: 52ch;
}
.hint {
  font-size: 11.5px;
  color: var(--text-faint);
  margin: 14px 0 18px;
}

.d-idx { font-size: 12px; color: var(--text-faint); width: 20px; flex-shrink:0; }
.d-name { font-size: 13px; color: var(--text); flex: 1 1 180px; min-width: 0; }
.d-bar-track {
  flex: 1 1 90px;
  height: 6px;
  background: var(--panel-2);
  border-radius: 3px;
  overflow: hidden;
  border: 1px solid var(--border-soft);
}
.d-bar-fill {
  display:block;
  height: 100%;
  background: linear-gradient(90deg, var(--blue), var(--green));
  width: 0%;
  transition: width 0.9s cubic-bezier(.2,.8,.2,1);
}
.d-weight { font-size: 12px; color: var(--text-dim); width: 36px; text-align: right; flex-shrink:0; }
.d-acc { font-size: 10.5px; color: var(--text-faint); width: 40px; text-align: right; flex-shrink:0; }

.domain-row {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 10px 8px;
  margin: 0;
  border: none;
  border-bottom: 1px solid var(--border-soft);
  background: none;
  font-family: var(--mono);
  color: inherit;
  text-align: left;
  cursor: pointer;
  border-radius: var(--radius);
}
.domain-row:hover { background: var(--panel-2); }
.domain-row:focus-visible { outline: 2px solid var(--blue); outline-offset: -2px; }
.domain-row:last-of-type { border-bottom: none; }

.domain-stat-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 9px 8px;
  border-bottom: 1px solid var(--border-soft);
}
.domain-stat-row:last-of-type { border-bottom: none; }

.btn-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
.btn {
  font-family: var(--mono);
  font-size: 13px;
  padding: 11px 16px;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background: var(--panel-2);
  color: var(--text);
  cursor: pointer;
  transition: border-color .15s, color .15s, background .15s;
}
.btn:hover { border-color: var(--blue); color: #fff; }
.btn:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
.btn.primary { background: var(--blue-soft); border-color: var(--blue); color: #cfe4ff; }
.btn.primary:hover { background: var(--blue); color: #05131f; }
.btn[disabled] { opacity: 0.35; cursor: not-allowed; }
.btn[disabled]:hover { border-color: var(--border); color: var(--text); }

.stat-line { font-size: 11.5px; color: var(--text-faint); margin-top: 18px; }

.qmeta {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-faint);
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-bottom: 14px;
}
.qprogress-track {
  height: 3px;
  background: var(--panel-2);
  margin-bottom: 22px;
  border-radius: 2px;
  overflow: hidden;
}
.qprogress-fill { height: 100%; background: var(--blue); transition: width .3s; }

.qtext { font-size: 15px; line-height: 1.55; color: var(--text); margin-bottom: 20px; }

.opt {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  width: 100%;
  text-align: left;
  font-family: var(--mono);
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--text);
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 14px;
  margin-bottom: 8px;
  cursor: pointer;
  transition: border-color .12s, background .12s;
}
.opt:hover:not([disabled]) { border-color: var(--blue); }
.opt:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
.opt .k { color: var(--text-faint); flex-shrink: 0; }
.opt-text { flex: 1; }
.opt[disabled] { cursor: default; }
.opt.correct { border-color: var(--green); background: var(--green-soft); }
.opt.correct .k { color: var(--green); }
.opt.wrong { border-color: var(--red); background: var(--red-soft); }
.opt.wrong .k { color: var(--red); }
.tag { margin-left: auto; font-size: 11px; letter-spacing: .04em; flex-shrink:0; }
.opt.correct .tag { color: var(--green); }
.opt.wrong .tag { color: var(--red); }

.explain {
  margin-top: 14px;
  padding: 14px;
  background: var(--panel-2);
  border-left: 2px solid var(--blue);
  border-radius: 0 var(--radius) var(--radius) 0;
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-dim);
  animation: fadein .25s ease;
}
@keyframes fadein { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
.explain b { color: var(--text); }

.footer-row { display:flex; justify-content: space-between; align-items:center; margin-top: 18px; }
.link-btn { background:none; border:none; color: var(--text-faint); font-family: var(--mono); font-size:12px; cursor:pointer; text-decoration: underline; padding:4px 0; }
.link-btn:hover { color: var(--text-dim); }
.link-btn:focus-visible { outline: 2px solid var(--blue); }

.score-big { font-size: 42px; font-weight: 700; color: var(--text); margin: 4px 0 2px; }
.score-sub { font-size: 12px; color: var(--text-faint); margin-bottom:22px; }

@media (max-width: 480px) {
  .term-body { padding: 20px 16px; }
  .d-name { flex-basis: 110px; font-size: 12px; }
  .d-acc { display:none; }
  .score-big { font-size: 34px; }
  .title { font-size: 18px; }
}
@media (prefers-reduced-motion: reduce) {
  .cursor { animation: none; opacity: 1; }
  .d-bar-fill { transition: none; }
  .explain { animation: none; }
}
</style>
</head>
