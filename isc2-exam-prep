<script>
var DOMAINS = [
  {id:1, name:"Security Principles", slug:"security-principles", weight:26},
  {id:2, name:"Business Continuity, DR & Incident Response", slug:"bc-dr-ir", weight:10},
  {id:3, name:"Access Control Concepts", slug:"access-control", weight:22},
  {id:4, name:"Network Security", slug:"network-security", weight:24},
  {id:5, name:"Security Operations", slug:"security-operations", weight:18}
];

var QUESTIONS = [
{id:1,domain:1,text:"Which component of the CIA triad ensures that data has not been altered by unauthorized parties?",opts:["Confidentiality","Integrity","Availability","Non-repudiation"],correct:1,exp:"Integrity guarantees information stays accurate and unmodified except by authorized action. Confidentiality protects against unauthorized disclosure, availability ensures access when needed, and non-repudiation prevents denial of an action."},
{id:2,domain:1,text:"A company encrypts customer records so only authorized staff can read them. Which CIA principle is being enforced?",opts:["Availability","Confidentiality","Integrity","Accountability"],correct:1,exp:"Encryption restricts who can view data, which is the definition of confidentiality. It does not by itself confirm the data is unchanged (integrity) or guarantee uptime (availability)."},
{id:3,domain:1,text:"A ransomware attack encrypts a hospital's patient database, making it inaccessible to doctors. Which security principle has been most directly violated?",opts:["Confidentiality","Integrity","Availability","Authentication"],correct:2,exp:"Ransomware primarily denies legitimate access to data, which is an availability failure. The immediate harm described is authorized staff being unable to use the data, even though confidentiality was also technically breached."},
{id:4,domain:1,text:"What does non-repudiation guarantee in a security context?",opts:["That data is encrypted while stored","That a party cannot deny having performed an action","That a system is always available","That only authorized users can log in"],correct:1,exp:"Non-repudiation provides proof of origin and integrity of a message or action so the sender cannot later deny sending it, typically achieved through digital signatures and audit logs."},
{id:5,domain:1,text:"What is the primary difference between authentication and authorization?",opts:["Authentication grants permissions; authorization proves identity","Authentication proves identity; authorization determines what an identified user can do","They are the same process","Authorization happens before authentication"],correct:1,exp:"Authentication verifies who a user is, such as via a password or biometrics, while authorization determines what that verified identity is permitted to access or do."},
{id:6,domain:1,text:"Which type of security control is a fence around a data center?",opts:["Technical","Administrative","Physical","Detective"],correct:2,exp:"A fence is a physical control because it restricts physical access to a location. Technical controls involve technology like firewalls, and administrative controls involve policies and procedures."},
{id:7,domain:1,text:"A security awareness training program that teaches employees to recognize phishing emails is an example of which control category?",opts:["Physical control","Administrative control","Technical control","Corrective control"],correct:1,exp:"Training and policy-driven measures fall under administrative controls, which govern human behavior and organizational process rather than physical barriers or technology."},
{id:8,domain:1,text:"Which control type is designed to identify that a security incident has already occurred?",opts:["Preventive","Deterrent","Detective","Compensating"],correct:2,exp:"Detective controls, such as intrusion detection systems and audit logs, identify and alert on incidents after they happen. Preventive controls try to stop incidents before they occur."},
{id:9,domain:1,text:"An organization installs security cameras that are clearly visible to discourage theft. This is primarily an example of which control type?",opts:["Deterrent","Corrective","Detective","Compensating"],correct:0,exp:"Visible cameras are meant to discourage bad behavior before it happens, which is the definition of a deterrent control, even though the same cameras can also serve a detective function."},
{id:10,domain:1,text:"Restoring a system from backup after a malware infection is an example of which control type?",opts:["Preventive","Corrective","Deterrent","Physical"],correct:1,exp:"Corrective controls repair or restore systems after an incident has caused harm. Backups and restoration reduce the impact of an event that has already occurred."},
{id:11,domain:1,text:"An organization cannot afford a full redundant data center, so it instead increases backup frequency and staff monitoring. This is an example of which control type?",opts:["Preventive control","Compensating control","Deterrent control","Physical control"],correct:1,exp:"A compensating control is an alternative safeguard used when the primary control is not feasible, providing a similar level of protection through different means."},
{id:12,domain:1,text:"What is the general relationship commonly used to describe risk?",opts:["Risk = Asset x Vulnerability","Risk is a function of a threat exploiting a vulnerability against an asset, producing impact","Risk = Control x Threat","Risk = Availability x Confidentiality"],correct:1,exp:"Risk is commonly understood as a threat exploiting a vulnerability against an asset to cause impact. Remove any one factor, no threat, no vulnerability, or no asset value, and risk drops to near zero."},
{id:13,domain:1,text:"A company purchases cybersecurity insurance instead of building additional defenses. Which risk treatment strategy is this?",opts:["Risk avoidance","Risk mitigation","Risk transfer","Risk acceptance"],correct:2,exp:"Buying insurance shifts the financial impact of a risk to a third party, which is risk transfer. It does not reduce the likelihood of the event, which mitigation would do, or eliminate the activity, which avoidance would do."},
{id:14,domain:1,text:"A business discontinues an online feature entirely because the associated risk is too high to manage. Which risk treatment is this?",opts:["Risk avoidance","Risk mitigation","Risk transfer","Risk acceptance"],correct:0,exp:"Eliminating the activity that creates the risk entirely is risk avoidance. Risk mitigation would instead reduce the risk while keeping the feature running."},
{id:15,domain:1,text:"A small business decides a control's cost outweighs the low-impact risk it addresses, and takes no action. Which risk treatment is this?",opts:["Risk transfer","Risk acceptance","Risk mitigation","Risk avoidance"],correct:1,exp:"Risk acceptance means the organization acknowledges a risk and chooses to tolerate it, usually because the cost of treatment exceeds the potential impact."},
{id:16,domain:1,text:"What is the key difference between qualitative and quantitative risk assessment?",opts:["Qualitative uses monetary values; quantitative uses relative ratings","Qualitative uses relative ratings like high, medium, or low; quantitative uses numerical or monetary values","They always produce identical results","Quantitative only applies to physical security"],correct:1,exp:"Qualitative assessment ranks risks using descriptive scales such as high, medium, or low, while quantitative assessment assigns numerical or monetary values, such as calculating Annual Loss Expectancy."},
{id:17,domain:1,text:"An asset is worth $50,000 and a threat is expected to destroy 20% of its value each time it occurs. What is the Single Loss Expectancy (SLE)?",opts:["$5,000","$10,000","$20,000","$50,000"],correct:1,exp:"SLE equals Asset Value multiplied by Exposure Factor: $50,000 x 0.20 = $10,000."},
{id:18,domain:1,text:"If the SLE is $10,000 and the event is expected to occur twice per year, what is the Annual Loss Expectancy (ALE)?",opts:["$5,000","$10,000","$20,000","$2,000"],correct:2,exp:"ALE equals SLE multiplied by the Annualized Rate of Occurrence: $10,000 x 2 = $20,000."},
{id:19,domain:1,text:"Under the ISC2 Code of Ethics, which of the following is the first and highest-priority canon?",opts:["Advance and protect the profession","Act honorably, honestly, justly, responsibly, and legally","Protect society, the common good, necessary public trust and confidence, and the infrastructure","Provide diligent and competent service to principals"],correct:2,exp:"The ISC2 Code of Ethics lists its canons in priority order, and protecting society, the common good, public trust, and the infrastructure is the first and highest-priority canon."},
{id:20,domain:1,text:"A security document states the specific brand and model of firewall every department must use. What type of governance document is this most likely to be?",opts:["Policy","Standard","Guideline","Law"],correct:1,exp:"Standards specify mandatory, specific requirements, such as particular products or configurations, that support a broader policy. Policies state high-level intent, while guidelines offer recommended but non-mandatory advice."},
{id:21,domain:1,text:"What distinguishes a guideline from a standard in security governance?",opts:["Guidelines are mandatory; standards are optional","Guidelines are recommended best practices; standards are mandatory requirements","They mean the same thing","Guidelines only apply to physical security"],correct:1,exp:"Standards must be followed to comply with policy, while guidelines offer recommended, flexible advice on how to achieve an objective."},
{id:22,domain:1,text:"What is the difference between due care and due diligence?",opts:["Due care is investigating risk; due diligence is acting on findings","Due diligence is the research done before acting; due care is the continued effort to act responsibly afterward","They mean the same thing","Due diligence only applies after an incident"],correct:1,exp:"Due diligence refers to the research and investigation performed before making a decision, while due care refers to the ongoing, reasonable actions taken to maintain security and meet obligations."},
{id:23,domain:1,text:"Which principle limits a user's access rights to only what is strictly necessary to perform their job function?",opts:["Separation of duties","Least privilege","Defense in depth","Non-repudiation"],correct:1,exp:"Least privilege restricts each user or process to the minimum access needed, reducing the potential damage from error, misuse, or compromise."},
{id:24,domain:1,text:"Requiring two different employees to each complete part of a financial transaction before it is approved is an example of which principle?",opts:["Least privilege","Separation of duties","Defense in depth","Risk transfer"],correct:1,exp:"Separation of duties divides critical tasks among multiple people so no single individual can complete a sensitive process alone, reducing fraud and error risk."},
{id:25,domain:1,text:"What is the core idea behind defense in depth?",opts:["Relying on a single very strong control","Layering multiple, overlapping security controls so that if one fails, others still protect the asset","Accepting all risk to reduce cost","Outsourcing all security responsibility to a vendor"],correct:1,exp:"Defense in depth uses multiple layers of physical, technical, and administrative controls so that the failure of any one layer does not fully expose the asset."},
{id:26,domain:1,text:"In a zero trust security model, what is the guiding assumption?",opts:["Users inside the network perimeter are automatically trusted","No user or device should be trusted by default, even inside the network, and must be continuously verified","Only external users need to be authenticated","Firewalls alone are sufficient protection"],correct:1,exp:"Zero trust assumes breach and requires continuous verification of every user and device regardless of location, rather than granting implicit trust based on network location."},
{id:27,domain:2,text:"What is the primary goal of a Business Continuity Plan (BCP)?",opts:["To restore IT infrastructure after a disaster","To keep critical business functions operating during and after a disruption","To prosecute attackers after a breach","To encrypt sensitive data"],correct:1,exp:"A BCP focuses on maintaining or quickly resuming essential business operations during a disruption, which is broader than just restoring IT systems."},
{id:28,domain:2,text:"What is the primary goal of a Disaster Recovery Plan (DRP)?",opts:["To maintain employee morale","To restore IT systems, applications, and data after a disruptive event","To train staff on phishing recognition","To set organizational risk appetite"],correct:1,exp:"A DRP focuses specifically on restoring technology infrastructure, systems, and data after a disaster, and is typically a subset of the broader BCP."},
{id:29,domain:2,text:"What does a Business Impact Analysis (BIA) primarily help an organization identify?",opts:["The technical specifications of firewalls","Critical business functions and the impact of their disruption over time","The names of all employees","The color scheme of an incident dashboard"],correct:1,exp:"A BIA identifies critical processes and dependencies and quantifies the operational and financial impact of downtime, which informs recovery priorities and timeframes."},
{id:32,domain:2,text:"A company can tolerate losing at most 1 hour of data but needs systems restored within 4 hours. Which pair of terms describes these two requirements respectively?",opts:["RTO of 1 hour, RPO of 4 hours","RPO of 1 hour, RTO of 4 hours","MTD of 1 hour, RPO of 4 hours","SLE of 1 hour, ARO of 4 hours"],correct:1,exp:"Data loss tolerance is RPO, which is 1 hour here, and the time to restore systems is RTO, which is 4 hours here."},
{id:33,domain:2,text:"Which backup type captures all data changed since the last full backup, regardless of any incremental backups taken since?",opts:["Full backup","Incremental backup","Differential backup","Snapshot backup"],correct:2,exp:"A differential backup includes all changes since the last full backup, growing larger each day until the next full backup, unlike incremental backups which only capture changes since the last backup of any type."},
{id:34,domain:2,text:"Which type of alternate recovery site is fully equipped and can take over operations within minutes to hours?",opts:["Cold site","Warm site","Hot site","Mobile site"],correct:2,exp:"A hot site is a fully operational duplicate facility with up-to-date data and systems, allowing near-immediate failover, whereas warm sites need some setup and cold sites take much longer to become operational."},
{id:35,domain:2,text:"What best describes a cold site in disaster recovery planning?",opts:["A fully staffed and operational duplicate facility","A facility with basic infrastructure like power and space but no pre-installed systems or data","A site with servers configured but not updated","A cloud-only backup solution"],correct:1,exp:"A cold site provides physical space, power, and connectivity but requires equipment and data to be brought in and configured before use, making it the slowest and cheapest option to activate."},
{id:36,domain:2,text:"What is the correct general order of the incident response process?",opts:["Containment, Preparation, Detection, Eradication, Recovery, Lessons Learned","Preparation, Detection and Identification, Containment, Eradication, Recovery, Lessons Learned","Detection, Preparation, Recovery, Containment, Eradication","Eradication, Containment, Preparation, Detection, Recovery"],correct:1,exp:"The standard incident response lifecycle begins with Preparation, followed by Detection and Identification, Containment to limit damage, Eradication of the root cause, Recovery of normal operations, and finally Lessons Learned."},
{id:37,domain:2,text:"During an active ransomware outbreak, isolating infected machines from the network to stop further spread is part of which incident response phase?",opts:["Preparation","Containment","Eradication","Lessons learned"],correct:1,exp:"Containment focuses on limiting the scope and impact of an ongoing incident, such as isolating affected systems, before the threat is fully removed."},
{id:38,domain:2,text:"What is the main purpose of a lessons learned review after an incident?",opts:["To assign blame to individual employees","To identify what happened, what worked, and what should improve for future incidents","To immediately restore all systems","To notify law enforcement"],correct:1,exp:"The lessons learned phase analyzes the incident response process itself to identify gaps and improvements, strengthening preparation for future incidents rather than assigning individual blame."},
{id:39,domain:3,text:"What do the three components of the AAA framework stand for?",opts:["Authentication, Authorization, Accounting","Access, Audit, Availability","Authentication, Audit, Authorization","Accounting, Access, Authorization"],correct:0,exp:"AAA stands for Authentication, which verifies identity, Authorization, which grants permissions, and Accounting, which tracks and logs user activity."},
{id:40,domain:3,text:"A user logs in with a password and a one-time code sent to their phone. What authentication concept does this demonstrate?",opts:["Single sign-on","Multi-factor authentication","Federation","Role-based access control"],correct:1,exp:"Using two different factors, something you know and something you have, is multi-factor authentication, which strengthens identity verification beyond a password alone."},
{id:41,domain:3,text:"Which authentication factor category does a fingerprint scan belong to?",opts:["Something you know","Something you have","Something you are","Somewhere you are"],correct:2,exp:"Biometric characteristics such as fingerprints belong to the something you are factor category, distinct from knowledge-based passwords or possession-based tokens."},
{id:42,domain:3,text:"What does Discretionary Access Control (DAC) allow?",opts:["A central authority strictly assigns all access based on classification labels","The owner of a resource decides who is granted access to it","Access is granted only based on job role","Access is granted based on a fixed set of system rules only"],correct:1,exp:"In DAC, the resource owner has discretion to grant or restrict access to other users, offering flexibility but less centralized control than MAC."},
{id:43,domain:3,text:"Which access control model uses security labels such as Confidential or Top Secret and is common in military and government systems?",opts:["DAC","MAC","RBAC","ABAC"],correct:1,exp:"Mandatory Access Control enforces access based on fixed classification labels and clearance levels set by a central authority, and users cannot alter these permissions themselves."},
{id:44,domain:3,text:"An organization grants system access based on job titles such as HR Manager or IT Support, with predefined permission sets for each. Which access control model is this?",opts:["DAC","MAC","RBAC","Rule-based access control"],correct:2,exp:"Role-Based Access Control assigns permissions to roles rather than individuals, and users inherit permissions based on their assigned role, simplifying administration."},
{id:45,domain:3,text:"Which access control model grants or denies access dynamically based on a combination of user, resource, and environmental attributes such as department, time of day, and device location?",opts:["DAC","MAC","RBAC","ABAC"],correct:3,exp:"Attribute-Based Access Control evaluates multiple attributes in real time to make access decisions, offering more granular and context-aware control than role-based approaches alone."},
{id:46,domain:3,text:"What is the need to know principle primarily concerned with?",opts:["Limiting access to information based on necessity for a specific task, even if the user holds sufficient clearance","Requiring all employees to know general company policy","Ensuring all employees know how to reset their passwords","Making all internal data publicly accessible"],correct:0,exp:"Need to know restricts access to specific information to only those who require it to perform their duties, even if they hold an appropriate clearance level, complementing least privilege."},
{id:47,domain:3,text:"What is a mantrap used for in physical security?",opts:["Encrypting data in transit","A small space with two interlocking doors that allows only one person through at a time","Detecting network intrusions","Storing backup tapes securely"],correct:1,exp:"A mantrap traps an individual between two doors, verifying identity before allowing entry and preventing an unauthorized person from following someone through."},
{id:48,domain:3,text:"What is tailgating, also called piggybacking, in physical security?",opts:["Encrypting data with an outdated protocol","An unauthorized person following an authorized person through a secured door without their own credentials","A type of malware spread through USB devices","A method of network traffic analysis"],correct:1,exp:"Tailgating occurs when someone without proper access gains entry by closely following an authorized individual through a secured door, exploiting courtesy rather than a technical flaw."},
{id:49,domain:3,text:"In biometric systems, what does a false acceptance mean?",opts:["An authorized user is incorrectly denied access","An unauthorized user is incorrectly granted access","The system fails to power on","The system requires a password reset"],correct:1,exp:"A false acceptance, also called a Type II error, occurs when a biometric system incorrectly identifies an unauthorized individual as authorized and grants access."},
{id:50,domain:3,text:"What does Single Sign-On (SSO) allow a user to do?",opts:["Log in once and access multiple independent systems without re-authenticating to each","Use a single password for one application only","Access only one system per day","Bypass all authentication controls"],correct:0,exp:"SSO allows a user to authenticate once and then access multiple connected applications or systems without logging in again to each one separately."},
{id:51,domain:3,text:"What is federation in identity and access management?",opts:["A method to physically secure a data center","An arrangement that allows identities and authentication to be trusted and shared across separate organizations or systems","A type of firewall configuration","A backup strategy"],correct:1,exp:"Federated identity allows a user's credentials from one trusted domain, such as their employer, to be used to access resources in another domain without creating a separate account."},
{id:52,domain:3,text:"What is the purpose of an account lockout policy?",opts:["To permanently disable all accounts after 90 days","To temporarily disable an account after a set number of failed login attempts","To automatically grant admin rights after repeated logins","To speed up the login process"],correct:1,exp:"Account lockout policies protect against brute-force password guessing by locking an account after a defined number of consecutive failed attempts."},
{id:53,domain:3,text:"What does deprovisioning refer to in identity and access management?",opts:["Creating a new user account","Granting elevated privileges to an administrator","Removing or disabling a user's access rights, typically when they leave an organization or change roles","Encrypting a user's stored files"],correct:2,exp:"Deprovisioning revokes a user's system access and accounts, which is critical to perform promptly when an employee departs or changes roles to prevent lingering unauthorized access."},
{id:54,domain:3,text:"Why is timely deprovisioning of former employees' accounts considered a critical security practice?",opts:["It reduces electricity costs","It prevents former employees from retaining unauthorized access to systems and data","It improves network speed","It only matters for physical access badges"],correct:1,exp:"Failing to promptly disable access for departed employees leaves an active account that could be used for unauthorized access, making timely deprovisioning an important control."},
{id:55,domain:3,text:"What is Privileged Access Management (PAM) primarily concerned with?",opts:["Managing guest Wi-Fi access","Controlling, monitoring, and securing accounts with elevated permissions, such as administrator accounts","Encrypting all outbound email","Managing physical building access badges only"],correct:1,exp:"PAM focuses specifically on securing and closely monitoring privileged accounts, such as administrators and root users, because their compromise poses outsized risk compared to standard accounts."},
{id:56,domain:3,text:"Which of the following is an example of a rule-based access control implementation?",opts:["A firewall that allows or denies traffic based on a predefined set of if-then rules","A manager granting file access to direct reports at their own discretion","Access based purely on job title","Access based on a data classification label alone"],correct:0,exp:"Rule-based access control applies a fixed set of rules, such as firewall ACL rules, to determine access or traffic flow, independent of user identity or role."},
{id:57,domain:3,text:"Why might an organization enforce a minimum password length and complexity requirement?",opts:["To make passwords easier to guess","To reduce the likelihood of successful brute-force or dictionary attacks","To reduce server storage costs","To comply with backup retention rules"],correct:1,exp:"Longer, more complex passwords increase the number of possible combinations an attacker must try, making brute-force and dictionary attacks significantly less practical."},
{id:58,domain:3,text:"A hospital only allows nurses to view the records of patients currently assigned to them, not all patients in the hospital. This is best described as an application of which principle?",opts:["Separation of duties","Need to know","Non-repudiation","Risk transfer"],correct:1,exp:"Restricting access to only the specific information required for a person's current task, even though they may be generally authorized to view patient records, exemplifies need to know."},
{id:101,domain:3,text:"In biometric systems, what does a false rejection, also called a Type I error, mean?",opts:["An unauthorized user is incorrectly granted access","An authorized user is incorrectly denied access","The biometric sensor overheats","The system automatically logs the user out"],correct:1,exp:"A false rejection, or Type I error, occurs when a biometric system incorrectly denies access to a legitimate, authorized user. This is the counterpart to a false acceptance, or Type II error, where an unauthorized user is incorrectly let in."},
{id:102,domain:3,text:"What does provisioning refer to in the identity and access management lifecycle?",opts:["Removing a departed employee's access","Creating a user account and granting the access rights required for a new role","Auditing existing user permissions for compliance","Resetting a user's forgotten password"],correct:1,exp:"Provisioning is the process of creating an account and granting the access rights needed when a new employee joins or a role changes. It is the counterpart to deprovisioning, which removes access once it is no longer needed."},
{id:59,domain:4,text:"How many layers does the OSI model have?",opts:["4","5","7","9"],correct:2,exp:"The OSI model has seven layers: Physical, Data Link, Network, Transport, Session, Presentation, and Application."},
{id:60,domain:4,text:"At which OSI layer do routers primarily operate, making forwarding decisions based on IP addresses?",opts:["Layer 2, Data Link","Layer 3, Network","Layer 4, Transport","Layer 7, Application"],correct:1,exp:"Routers operate at Layer 3, the Network layer, where logical IP addressing is used to determine the best path for forwarding packets between networks."},
{id:61,domain:4,text:"At which OSI layer do switches typically operate, using MAC addresses to forward frames?",opts:["Layer 1, Physical","Layer 2, Data Link","Layer 3, Network","Layer 4, Transport"],correct:1,exp:"Traditional switches operate at Layer 2, the Data Link layer, forwarding frames within a local network based on MAC addresses."},
{id:62,domain:4,text:"Which of the following is a private IP address range as defined by RFC 1918?",opts:["8.8.8.0/24","192.168.0.0/16","172.32.0.0/16","1.1.1.0/24"],correct:1,exp:"192.168.0.0/16 is one of the three RFC 1918 private address ranges, along with 10.0.0.0/8 and 172.16.0.0/12, reserved for private networks and not routable on the public internet."},
{id:63,domain:4,text:"What is the primary purpose of a MAC address?",opts:["To identify a device's physical network interface at Layer 2","To route traffic between different networks","To resolve domain names to IP addresses","To encrypt data in transit"],correct:0,exp:"A MAC address is a unique hardware identifier on a network interface card, used for communication within a local network segment at the Data Link layer."},
{id:64,domain:4,text:"Which port is commonly associated with unencrypted HTTP web traffic?",opts:["22","25","80","443"],correct:2,exp:"Port 80 is the standard port for HTTP traffic, while port 443 is used for encrypted HTTPS traffic."},
{id:65,domain:4,text:"Which port is commonly used for SSH remote administration?",opts:["21","22","23","3389"],correct:1,exp:"Port 22 is the standard port for SSH, which provides encrypted remote command-line access, unlike Telnet on port 23 which is unencrypted."},
{id:66,domain:4,text:"What is the primary function of DNS?",opts:["Assigning IP addresses to devices automatically","Translating human-readable domain names into IP addresses","Encrypting network traffic","Filtering malicious traffic"],correct:1,exp:"DNS resolves domain names, such as example.com, into the numeric IP addresses that computers use to locate and communicate with each other."},
{id:67,domain:4,text:"What is the primary function of DHCP?",opts:["Automatically assigning IP addresses and network configuration to devices","Translating domain names to IP addresses","Encrypting wireless traffic","Filtering inbound firewall traffic"],correct:0,exp:"DHCP automatically assigns IP addresses, subnet masks, gateways, and other configuration details to devices joining a network, removing the need for manual setup."},
{id:68,domain:4,text:"What is the main purpose of a firewall?",opts:["To physically secure network cabling","To monitor and control incoming and outgoing network traffic based on defined security rules","To automatically patch software vulnerabilities","To provide wireless connectivity"],correct:1,exp:"A firewall enforces a rule set that permits or blocks traffic between network segments based on criteria such as IP address, port, and protocol."},
{id:69,domain:4,text:"What is the key difference between an IDS and an IPS?",opts:["An IDS actively blocks malicious traffic; an IPS only alerts","An IDS only monitors and alerts on suspicious activity; an IPS can actively block or prevent it","They are identical in function","An IDS works only on wireless networks"],correct:1,exp:"An IDS passively monitors traffic and generates alerts for suspicious activity, while an IPS sits inline and can actively block or drop malicious traffic in real time."},
{id:70,domain:4,text:"What is the primary purpose of a VPN?",opts:["To physically isolate a network segment","To create an encrypted tunnel for secure communication over an untrusted network such as the internet","To assign static IP addresses","To speed up DNS resolution"],correct:1,exp:"A VPN encrypts traffic between endpoints, allowing secure, private communication across a public or untrusted network like the internet."},
{id:71,domain:4,text:"Why would an organization implement VLANs?",opts:["To physically separate cabling by color","To logically segment a network into separate broadcast domains without needing separate physical hardware","To increase wireless signal strength","To eliminate the need for firewalls entirely"],correct:1,exp:"VLANs logically divide a single physical network into multiple isolated broadcast domains, improving security through segmentation and reducing unnecessary broadcast traffic without extra physical switches."},
{id:72,domain:4,text:"Which wireless security protocol is currently considered the most secure and recommended standard?",opts:["WEP","WPA","WPA2","WPA3"],correct:3,exp:"WPA3 is the newest and most secure Wi-Fi security protocol, offering stronger encryption and better protection against offline password-guessing attacks than WEP, WPA, or WPA2."},
{id:73,domain:4,text:"Why is WEP considered insecure by modern standards?",opts:["It uses no encryption at all","It uses weak encryption and a flawed key management scheme that can be cracked relatively quickly","It only works on wired networks","It requires biometric authentication"],correct:1,exp:"WEP relies on a weak implementation of the RC4 cipher and static keys, which have well-documented vulnerabilities that let attackers crack the encryption quickly."},
{id:74,domain:4,text:"What best describes a Distributed Denial of Service (DDoS) attack?",opts:["A single attacker slowly guessing passwords over time","Overwhelming a target with traffic from multiple sources to disrupt availability","Intercepting and reading encrypted communications","Modifying DNS records to redirect traffic"],correct:1,exp:"A DDoS attack floods a target with traffic from many distributed, often compromised, sources to exhaust its resources and deny service to legitimate users."},
{id:75,domain:4,text:"In a Man-in-the-Middle attack, what does the attacker primarily do?",opts:["Physically damage network hardware","Secretly intercept and potentially alter communications between two parties who believe they are communicating directly","Flood a server with excessive requests","Guess a user's password through repeated attempts"],correct:1,exp:"A MITM attack positions the attacker between two communicating parties, allowing eavesdropping on or manipulation of traffic without either party being aware."},
{id:76,domain:4,text:"What is ARP spoofing used to accomplish?",opts:["Encrypting network traffic","Associating an attacker's MAC address with a legitimate IP address on a local network to intercept traffic","Registering a fraudulent domain name","Bypassing multi-factor authentication"],correct:1,exp:"ARP spoofing sends falsified ARP messages to associate the attacker's MAC address with a legitimate device's IP address, redirecting that device's traffic to the attacker."},
{id:77,domain:4,text:"What is the security purpose of a DMZ in network architecture?",opts:["To store encryption keys","To host public-facing services in a segmented zone, isolating them from the internal trusted network","To provide a backup power source","To physically secure server racks"],correct:1,exp:"A DMZ is a buffer segment hosting externally accessible services, keeping them isolated from the internal network so a compromise of a public-facing service does not directly expose internal systems."},
{id:78,domain:4,text:"What is the primary function of NAT?",opts:["Translating domain names into IP addresses","Allowing multiple devices on a private network to share a single public IP address for internet access","Encrypting traffic between two VPN endpoints","Assigning MAC addresses to new devices"],correct:1,exp:"NAT translates private internal IP addresses to a public address and back, letting multiple internal devices share one public-facing address while hiding internal addressing."},
{id:79,domain:4,text:"What is a primary security benefit of network segmentation?",opts:["It eliminates the need for authentication","It limits how far an attacker can move within a network if one segment is compromised","It guarantees 100% uptime","It removes the need for encryption"],correct:1,exp:"Segmentation divides a network into smaller isolated zones, containing the impact of a breach and limiting an attacker's ability to move laterally to other critical systems."},
{id:80,domain:4,text:"In the cloud service model spectrum, which model gives the customer the least infrastructure management responsibility?",opts:["IaaS","PaaS","SaaS","On-premises hosting"],correct:2,exp:"In SaaS, the provider manages the entire stack including the application itself, and the customer simply uses the software, unlike IaaS or PaaS where the customer manages more of the underlying infrastructure."},
{id:81,domain:4,text:"In the cloud service model spectrum, which model gives the customer the most control over operating system and infrastructure configuration?",opts:["SaaS","PaaS","IaaS","FaaS"],correct:2,exp:"IaaS provides virtualized computing resources such as servers, storage, and networking, leaving the customer responsible for managing the operating system, applications, and configuration."},
{id:82,domain:4,text:"What is the main function of a proxy server in a network?",opts:["To assign IP addresses dynamically","To act as an intermediary between clients and other servers, filtering content, caching data, and masking client identity","To physically secure a server room","To provide biometric authentication"],correct:1,exp:"A proxy server sits between clients and a destination server, forwarding requests on the client's behalf, which allows content filtering, caching, and hiding the client's real IP address."},
{id:83,domain:5,text:"What are the three states in which data can exist, relevant to applying appropriate security controls?",opts:["Encrypted, decrypted, hashed","Data at rest, data in transit, data in use","Public, private, confidential","Structured, unstructured, semi-structured"],correct:1,exp:"Data at rest, meaning stored data, data in transit, meaning data moving across a network, and data in use, meaning data actively being processed, each require tailored security controls."},
{id:84,domain:5,text:"Which type of protection is most appropriate for data as it travels across a network, such as during a web transaction?",opts:["Encryption for data at rest only","Encryption for data in transit, such as TLS","No protection is needed for network traffic","Only physical security controls apply"],correct:1,exp:"Protocols such as TLS encrypt data in transit, protecting it from interception as it moves across networks like the internet."},
{id:85,domain:5,text:"What is the purpose of data classification in an organization?",opts:["To determine server rack placement","To categorize data based on sensitivity so appropriate handling and protection controls can be applied","To assign IP addresses to data servers","To calculate the ARO for risk assessments"],correct:1,exp:"Data classification, such as public, internal, confidential, and restricted, helps an organization apply proportionate security controls and handling procedures based on how sensitive the data is."},
{id:86,domain:5,text:"What does system hardening refer to?",opts:["Increasing the physical weight of server hardware","Reducing a system's attack surface by disabling unnecessary services, closing unused ports, and applying secure configurations","Adding more RAM to improve performance","Training employees on phishing awareness"],correct:1,exp:"Hardening reduces potential vulnerabilities by removing or disabling unnecessary software, services, accounts, and ports, and applying secure configuration baselines."},
{id:87,domain:5,text:"Why is timely patch management considered a critical security operations practice?",opts:["It improves the visual design of software","It closes known vulnerabilities in software before attackers can exploit them","It eliminates the need for firewalls","It automatically classifies data"],correct:1,exp:"Patches often fix known security vulnerabilities, and delaying their application leaves systems exposed to exploits that target those already-disclosed weaknesses."},
{id:88,domain:5,text:"What is a configuration baseline in the context of system hardening?",opts:["A random configuration applied to test systems","A documented, standardized secure configuration that serves as a reference point for a system","A backup schedule","A physical inventory of hardware assets"],correct:1,exp:"A configuration baseline defines the approved, secure settings a system should have, providing a reference for detecting unauthorized changes and ensuring consistency across similar systems."},
{id:89,domain:5,text:"What is the primary purpose of a formal change management process?",opts:["To allow any employee to modify production systems at any time without approval","To ensure changes to systems are reviewed, approved, tested, and documented to minimize unintended impact","To eliminate the need for backups","To replace the incident response process"],correct:1,exp:"Change management ensures modifications to IT systems go through a controlled process of review and approval, reducing the risk of outages or security gaps caused by uncoordinated changes."},
{id:90,domain:5,text:"What is the main purpose of a SIEM system?",opts:["To physically secure server rooms","To aggregate, correlate, and analyze log data from multiple sources to detect and alert on security events","To assign user roles and permissions","To encrypt data at rest"],correct:1,exp:"A SIEM centralizes log and event data across an organization's systems, applying correlation rules and analytics to detect suspicious patterns and generate alerts."},
{id:91,domain:5,text:"Why is centralized logging and monitoring important in security operations?",opts:["It removes the need for access controls","It enables detection of suspicious activity, supports investigations, and provides an audit trail across systems","It automatically prevents all attacks","It replaces the need for antivirus software"],correct:1,exp:"Centralized logs provide visibility across the environment, allowing teams to detect anomalies, investigate incidents, and demonstrate compliance through a reliable audit trail."},
{id:92,domain:5,text:"What is the primary goal of security awareness training for general employees?",opts:["To teach employees to write secure code","To help employees recognize and appropriately respond to threats such as phishing and social engineering","To train employees to configure firewalls","To certify employees as penetration testers"],correct:1,exp:"Security awareness training targets the general workforce, focusing on recognizing common threats like phishing and social engineering, since employees are often the first line of defense."},
{id:93,domain:5,text:"An attacker calls an employee pretending to be from IT support and convinces them to reveal their password. What social engineering technique is this?",opts:["Tailgating","Pretexting","Baiting","Shoulder surfing"],correct:1,exp:"Pretexting involves creating a fabricated scenario or false identity to manipulate a victim into divulging information, as opposed to baiting, which offers something enticing, or shoulder surfing, which is visual observation."},
{id:94,domain:5,text:"An attacker leaves an infected USB drive labeled Payroll 2026 in a company parking lot, hoping an employee will plug it in. What social engineering technique is this?",opts:["Phishing","Baiting","Pretexting","Tailgating"],correct:1,exp:"Baiting lures a victim into an action, such as plugging in a malicious USB drive, by offering something appealing or curiosity-inducing."},
{id:95,domain:5,text:"What is the primary purpose of an Acceptable Use Policy (AUP)?",opts:["To define acceptable salary ranges","To outline the rules and expected behavior for employees using organizational IT systems and resources","To specify data backup schedules","To describe the encryption algorithm used company-wide"],correct:1,exp:"An AUP sets clear expectations for how employees may appropriately use company systems, networks, and devices, helping reduce misuse and legal or security risk."},
{id:96,domain:5,text:"What is the main goal of a vulnerability management program?",opts:["To eliminate all risk permanently","To continuously identify, assess, prioritize, and remediate security weaknesses in systems","To replace the need for incident response","To manage employee vacation schedules"],correct:1,exp:"Vulnerability management is an ongoing cycle of scanning for weaknesses, assessing severity, prioritizing remediation, and verifying fixes, since eliminating all risk is not realistically achievable."},
{id:97,domain:5,text:"What is the primary function of antivirus and anti-malware software?",opts:["To encrypt all outbound traffic","To detect, prevent, and remove malicious software from a system","To manage user access permissions","To perform network segmentation"],correct:1,exp:"Antivirus and anti-malware tools scan for, block, and remove known and suspicious malicious software based on signatures, heuristics, or behavioral analysis."},
{id:98,domain:5,text:"What is the key difference between symmetric and asymmetric encryption?",opts:["Symmetric uses one shared key for both encryption and decryption; asymmetric uses a mathematically linked public and private key pair","Symmetric is always more secure than asymmetric","Asymmetric encryption requires no keys at all","They are functionally identical"],correct:0,exp:"Symmetric encryption uses the same secret key for both encrypting and decrypting, while asymmetric encryption uses a public key to encrypt and a mathematically related private key to decrypt, avoiding the need to share a secret key."},
{id:99,domain:5,text:"What is the primary purpose of hashing, as distinct from encryption?",opts:["To make data unreadable and later reversible with a key","To produce a fixed-length, one-way digest of data used to verify integrity, without being intended to be reversed","To compress large files for storage","To assign IP addresses"],correct:1,exp:"Hashing creates a fixed-size, unique digest of data that is not meant to be reversed, primarily used to verify data has not been altered, unlike encryption, which is designed to be decrypted."},
{id:100,domain:5,text:"What role does a Certificate Authority (CA) play in a Public Key Infrastructure (PKI)?",opts:["It stores backup copies of all company data","It issues and vouches for the validity of digital certificates that bind public keys to verified identities","It manages employee physical access badges","It performs network traffic filtering"],correct:1,exp:"A Certificate Authority is a trusted entity that issues digital certificates, verifying a public key belongs to the identified entity, which underpins trust in systems like HTTPS."}
